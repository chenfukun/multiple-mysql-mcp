{
  "name": "multiple-mysql-mcp",
  "version": "1.0.1",
  "description": "An MCP stdio server that provides read-only access to multiple MySQL instances via a single MCP connection.",
  "type": "module",
  "bin": {
    "multiple-mysql-mcp": "build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector -e MYSQL_CONFIG_FILE=./config.json node build/index.js"
  },
  "keywords": [
    "mcp",
    "mysql",
    "database",
    "model-context-protocol",
    "ai",
    "llm",
    "multi-instance"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/chenfukun/multiple-mysql-mcp.git"
  },
  "author": "john",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "0.6.0",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "cross-env": "^10.1.0",
    "typescript": "^5.3.3"
  }
}
